{
  "name": "hongguo-open-player",
  "version": "1.3.2",
  "description": "摸鱼侠，支持红果短剧、抖音和 B 站的开源桌面播放器。",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "node src/server/index.js",
    "app": "electron .",
    "test": "npm run test:unit && npm run test:e2e",
    "build:mac": "electron-builder --mac --arm64 --x64 --publish never",
    "build:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "build:mac:x64": "electron-builder --mac --x64 --publish never",
    "build:mac:dir": "electron-builder --mac --dir --publish never",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:all": "electron-builder --mac --arm64 --x64 --win --x64 --publish never",
    "test:unit": "node test/run-unit.js",
    "test:e2e": "node test/verify-e2e.js",
    "test:arm64": "node test/verify-mac-arm64-ep5plus.js"
  },
  "build": {
    "appId": "com.zfdang.hongguo.openplayer",
    "productName": "摸鱼侠",
    "copyright": "Copyright © 2026",
    "publish": null,
    "beforePack": "scripts/build-mac-dock-helper.js",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "dist-electron"
    },
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "extraResources": [
        { "from": "build/bytevc2/${arch}", "to": "bytevc2" },
        { "from": "build/dock-helper/${arch}", "to": "dock-helper" }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "artifactName": "${name}-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "target": ["dmg", "zip"],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "安装摸鱼侠",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "extraResources": [{ "from": "build/bytevc2/${arch}", "to": "bytevc2" }],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${name}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "摸鱼侠",
      "artifactName": "${name}-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${name}-${version}-win-${arch}-portable.${ext}"
    },
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.ico",
      "build/icon.png"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangga/ShortDramaPlayer.git"
  },
  "keywords": [
    "hongguo",
    "short-drama",
    "electron",
    "macos",
    "player"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "dependencies": {
    "axios": "^1.21.0",
    "express": "^5.3.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
